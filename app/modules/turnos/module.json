{
  "id": "turnos",
  "name": "Turnos",
  "description": "The whole current appointment surface: booking wizard, queue, doctor agenda, waitlist, reminders, order-AI reading, HSI sync, booking chat + WhatsApp, reports. First and only app module at launch (Phase 6a) — see docs/modules.md for how a second module (intake/triage, teleconsulta, historia-clinica) would plug in next to it.",

  "requires": [],

  "routes": [
    {"module": "app.admin_panel.ai_register_screen", "router_attr": "api_router", "methods": ["GET", "POST"]},
    {"module": "app.admin_panel.admin_agenda_print_screen", "router_attr": "api_router", "methods": ["GET"]},
    {"module": "app.modules.turnos.external_history_router", "router_attr": "router", "methods": ["GET"]},
    {"module": "app.modules.turnos.study_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.admin_panel.admin_usability_screen", "methods": ["GET", "POST"], "router_attr": "api_router"},
    {"module": "app.patient_web.site_shell", "methods": ["GET", "POST", "DELETE"], "after": {"GET": "app.core.i18n", "POST": "app.ops.demo_installation", "DELETE": "app.ops.demo_installation"}},
    {"module": "app.patient_web.availability_directory", "methods": ["GET"], "after": "app.patient_web.site_shell"},
    {"module": "app.admin_panel.admin_content", "methods": ["GET", "POST", "PUT", "DELETE"], "after": {"GET": "app.cuentas.auth_renaper", "POST": "app.cuentas.accounts", "PUT": "app.ops.demo_installation", "DELETE": "app.patient_web.site_shell"}},
    {"module": "app.admin_panel.admin_patients", "methods": ["GET", "POST", "PUT", "DELETE"], "after": {"GET": "app.auth.passkeys", "POST": "app.auth.passkeys", "PUT": "app.admin_panel.admin_preferences", "DELETE": "app.admin_panel.admin_users"}},
    {"module": "app.admin_panel.admin_appointments", "methods": ["GET", "POST"], "after": "app.admin_panel.admin_patients"},
    {"module": "app.admin_panel.reports", "methods": ["GET"], "after": "app.admin_panel.admin_appointments"},
    {"module": "app.ai.ai_costs", "methods": ["GET"], "after": "app.admin_panel.reports"},
    {"module": "app.ai.ai_health", "methods": ["GET"], "after": "app.ai.ai_costs"},
    {"module": "app.patient_web.doctor_photos", "methods": ["GET", "POST", "DELETE"], "after": {"GET": "app.ai.ai_health", "POST": "app.admin_panel.admin_appointments", "DELETE": "app.admin_panel.admin_patients"}},
    {"module": "app.patient_web.avatar_sprite", "methods": ["GET"], "after": "app.patient_web.doctor_photos"},
    {"module": "app.admin_panel.doctor_patients", "methods": ["GET"], "after": "app.patient_web.avatar_sprite"},
    {"module": "app.ai.chart_summary", "methods": ["GET", "POST"], "after": {"GET": "app.admin_panel.doctor_patients", "POST": "app.auth.panel_login"}},
    {"module": "app.ai.lab_results", "methods": ["GET"], "after": "app.ai.chart_summary"},
    {"module": "app.patient_web.sitemap", "methods": ["GET"], "after": "app.core.site_identity"},
    {"module": "app.cuentas.account_photo", "methods": ["GET", "POST", "DELETE"], "after": {"GET": "app.patient_web.sitemap", "POST": "app.cuentas.ocr_dni", "DELETE": "app.patient_web.branding"}},
    {"module": "app.connectors.puco.puco", "methods": ["POST"], "after": "app.patient_web.branding"},
    {"module": "app.cuentas.ocr_dni", "methods": ["POST"], "after": "app.connectors.puco.puco"},
    {"module": "app.ai.prompts", "methods": ["GET", "POST", "DELETE"], "after": {"GET": "app.admin_panel.settings_admin", "POST": "app.admin_panel.settings_admin", "DELETE": "app.modules.chat.mcp_api"}},
    {"module": "app.patient_web.patient_site_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.patient_web.availability_directory_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.modules.turnos.booking_requests_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.modules.turnos.slot_holds_router", "methods": ["POST", "DELETE"], "router_attr": "router"},
    {"module": "app.modules.turnos.appointment_offer_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.modules.turnos.appointment_confirm_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.admin_panel.admin_content_router", "methods": ["GET", "POST", "PUT", "DELETE"], "router_attr": "router"},
    {"module": "app.admin_panel.admin_patients_router", "methods": ["GET", "POST", "PUT", "DELETE"], "router_attr": "router"},
    {"module": "app.admin_panel.admin_appointments_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.modules.turnos.doctor_appointments_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.admin_panel.doctor_patients_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.admin_panel.reports_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.ai.chart_summary_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.ai.lab_results_router", "methods": ["GET", "POST", "DELETE"], "router_attr": "router"},
    {"module": "app.modules.turnos.preparation_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.patient_web.doctor_photos_router", "methods": ["GET", "POST", "DELETE"], "router_attr": "router"},
    {"module": "app.patient_web.avatar_sprite_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.patient_web.avatar_thumb_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.cuentas.account_photo_router", "methods": ["GET", "POST", "DELETE"], "router_attr": "router"},
    {"module": "app.ai.ai_costs_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.ai.ai_health_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.cuentas.ocr_dni_router", "methods": ["POST"], "router_attr": "router"},
    {"module": "app.ai.prompts_router", "methods": ["GET", "POST", "DELETE"], "router_attr": "router"},
    {"module": "app.modules.turnos.searches_router", "methods": ["POST"], "router_attr": "router"},
    {"module": "app.modules.turnos.analytics_api_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.modules.turnos.analytics_api_router", "methods": ["GET", "POST", "DELETE"], "router_attr": "admin_router"},
    {"module": "app.patient_web.sitemap_router", "methods": ["GET"], "router_attr": "router"},
    {"module": "app.connectors.puco.puco_router", "methods": ["POST"], "router_attr": "router"},
    {"module": "app.modules.turnos.calendar_feed_router", "methods": ["GET", "POST"], "router_attr": "router"},
    {"module": "app.admin_panel.doctor_workspace_screen", "methods": ["GET", "POST"], "router_attr": "api_router"}
  ],

  "admin_sections": [
    {"id": "ai-register", "label_key": "ai.register.title", "label": "AI register", "roles": ["admin"],
     "screen": {"path": "/admin/ai-register", "module": "app.admin_panel.ai_register_screen", "router_attr": "router", "template": "templates/admin/ai-register.html"}},
    {"id": "usability", "label": "Usability", "label_key": "study.admin.title", "roles": ["admin"], "screen": {"path": "/admin/usability", "module": "app.admin_panel.admin_usability_screen", "router_attr": "screen_router", "requires_settings": {"TURNOS_STUDY": "1", "TURNOS_DEMO_MODE": "1"}}},
    {"id": "solicitudes", "roles": ["admin", "medico", "admisionista"],
     "label_key": "admin.shell.nav.solicitudes", "label": "Solicitudes",
     "screen": {"path": "/admin/solicitudes", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_solicitudes_screen"}},
    {"id": "cola", "roles": ["admin", "medico", "admisionista"],
     "label_key": "admin.shell.nav.cola", "label": "Pacientes de hoy",
     "screen": {"path": "/admin/cola", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_cola_screen"}},
    {"id": "mis-turnos", "roles": ["medico"],
     "label_key": "admin.shell.nav.mis_turnos", "label": "Mis turnos",
     "screen": {"path": "/admin/mis-turnos", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_mis_turnos_screen"}},
    {"id": "mis-pacientes", "roles": ["admin", "medico"], "nav_hidden_for": ["admin"],
     "label_key": "admin.shell.nav.mis_pacientes", "label": "Mis pacientes",
     "screen": {"path": "/admin/my-patients", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_doctor_patients_screen"}},
    {"id": "pacientes", "roles": ["admin", "admisionista"],
     "label_key": "admin.shell.nav.pacientes", "label": "Pacientes",
     "screen": {"path": "/admin/pacientes", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_pacientes_screen"}},
    {"id": "reportes", "roles": ["admin", "reportes"],
     "label_key": "admin.shell.nav.reportes", "label": "Reportes",
     "screen": {"path": "/admin/reportes", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_reportes_screen"}},
    {"id": "preparaciones",
     "label_key": "admin.shell.nav.preparaciones", "label": "Cómo prepararse",
     "screen": {"path": "/admin/preparations", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_preparations_screen"}},
    {"id": "hsi",
     "label_key": "admin.shell.nav.hsi", "label": "HSI",
     "screen": {"path": "/admin/hsi", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_hsi_screen",
                "requires_capability": "emr_sync",
                "requires_connector": "hsi"}},
    {"id": "servicios",
     "label_key": "admin.shell.nav.servicios", "label": "Servicios",
     "screen": {"path": "/admin/services", "router_attr": "services_screen_router",
                "module": "app.admin_panel.admin_content_screen"}},
    {"id": "centros",
     "label_key": "admin.shell.nav.centros", "label": "Centros",
     "screen": {"path": "/admin/centers", "router_attr": "centers_screen_router",
                "module": "app.admin_panel.admin_content_screen"}},
    {"id": "medicos",
     "label_key": "admin.shell.nav.medicos", "label": "Médicos",
     "screen": {"path": "/admin/doctors", "router_attr": "doctors_screen_router",
                "module": "app.admin_panel.admin_content_screen"}},
    {"id": "knowledge",
     "label_key": "admin.shell.nav.knowledge", "label": "Wiki",
     "screen": {"path": "/admin/knowledge", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_knowledge_screen"}},
    {"id": "prompts",
     "label_key": "admin.shell.nav.prompts", "label": "AI instructions",
     "screen": {"path": "/admin/prompts", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_prompts_screen"}},
    {"id": "roles",
     "label_key": "admin.shell.nav.roles", "label": "Roles y permisos",
     "screen": {"path": "/admin/roles", "router_attr": "screen_router",
                "module": "app.admin_panel.admin_roles_screen"}},
    {"id": "onboarding", "roles": ["medico"], "screen": {"path": "/admin/onboarding", "module": "app.admin_panel.doctor_workspace_screen", "router_attr": "onboarding_router"}},
    {"id": "my-schedules", "roles": ["medico"], "label_key": "admin.doctor.schedules", "label": "Mis agendas", "screen": {"path": "/admin/my-schedules", "module": "app.admin_panel.doctor_workspace_screen", "router_attr": "schedules_router"}}
  ],

  "nav_entries": [
    {"path": "/doctors", "label": "Médicos", "label_key": "nav.doctors", "order": 10},
    {"path": "/d/diagnostico", "label": "Estudios", "label_key": "nav.studies", "order": 20},
    {"path": "/centers", "label": "Centros", "label_key": "nav.centers", "order": 30},
    {"path": "/d/grupos", "label": "Talleres", "label_key": "nav.groups", "order": 40},
    {"path": "/upload-order", "label": "Subí tu orden", "label_key": "nav.upload_order", "order": 50},
    {"path": "/my-requests", "label": "Mis turnos", "label_key": "nav.my_appointments", "order": 60}
  ],

  "assets": [
    {"path": "modules/turnos/study-runner.mjs", "fingerprint": true},
    {"path": "modules/turnos/confirm.mjs", "fingerprint": true},
    {"path": "modules/turnos/offer.mjs", "fingerprint": true},
    {"path": "modules/turnos/wz-upload.mjs", "fingerprint": true},
    {"path": "modules/turnos/service.mjs", "fingerprint": true},
    {"path": "modules/turnos/upload-order.mjs", "fingerprint": true}
  ],

  "locales": "modules/turnos/locales",


  "db_tables": [
    "study_sessions", "study_task_results", "study_events", "study_findings",
    "booking_requests", "dependents", "waitlist", "appointment_offers",
    "searches", "slot_holds", "ai_costs", "mcp_ai_budget",
    "hsi_outbox", "hsi_inbox", "hsi_sync_conflicts", "hsi_patients",
    "hsi_doctor_schedules", "hsi_appointments", "hsi_checkpoints",
    "ai_prompts", "ai_prompts_history", "ai_register_changes",
    "refeps_cache", "attendance_events", "appointment_events", "day_queue_events", "patient_summaries",
    "clinical_history_records", "lab_report_analysis", "patient_lab_uploads"
  ],

  "config_keys_prefixes": [
    "BOOKING_", "TURNOS_", "HSI_", "EMR_BRIDGE_", "OTP_", "META_WA_", "WEBTURNO_", "OWNER_",
