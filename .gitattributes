# Public source cut (scripts/public_cut_build.py archives HEAD with `git archive`).
# Paths marked export-ignore stay in this working repository and never enter the
# public tree: agent harness and its tests, installation-specific operations
# notes, and design working files. Keep the list in step with the forbidden
# paths of scripts/public_cut_policy.json, which re-checks the cut by name.
# A directory is named twice: bare, so the archive leaves no empty folder, and
# with /**, so `git check-attr` on a file under it answers too.
/.claude export-ignore
/.claude/** export-ignore
/CLAUDE.md export-ignore
/docs/design/plans export-ignore
/docs/design/plans/** export-ignore
/docs/design/design-qa.md export-ignore
# The design working files' former root places: tools outside the repository may still
# write there, and what they write must not reach the public cut either.
/design-plans export-ignore
/design-plans/** export-ignore
/design-qa.md export-ignore
/docs/pinamar export-ignore
/docs/pinamar/** export-ignore
/docs/portal-gateway-identity.md export-ignore
/scripts/usability/usability.pinamar.config.json export-ignore
/scripts/check_caps_movil.py export-ignore
/scripts/nightly-local.plist export-ignore
/scripts/public_cut_private_digests.json export-ignore
/scripts/fixes/staff_portal_admin.py export-ignore
/tests/test_demo_deploy_after_push.py export-ignore
# Research records made against the real installation's catalog (screenshots and
# model transcripts that name its real doctors and centers).
