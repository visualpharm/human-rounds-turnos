{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "usability-kit/preflight-report.v1.json",
  "title": "Preflight report (v1)",
  "type": "object",
  "required": ["schema", "version", "project", "base_url", "generated_at", "duration_ms",
               "viewports", "pages", "summary", "problems", "skipped"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "usability-kit/preflight-report" },
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "base_url": { "type": "string", "pattern": "^https?://" },
    "generated_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "viewports": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
    "pages": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "summary": {
      "type": "object",
      "required": ["critical", "serious", "moderate", "minor"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "serious": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "problems": { "type": "array", "items": { "$ref": "#/definitions/problem" } },
    "skipped": { "type": "array", "items": { "$ref": "#/definitions/skipped" } },
    "checks_run": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "walkthroughs": { "type": "array", "items": { "$ref": "#/definitions/walkthrough" } }
  },
  "definitions": {
    "walkthrough": {
      "type": "object",
      "required": ["name", "start", "steps", "ran", "ok"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "start": { "type": "string" },
        "steps": { "type": "integer", "minimum": 0 },
        "ran": { "type": "boolean" },
        "ok": { "type": "boolean" }
      }
    },
    "problem": {
      "type": "object",
      "required": ["id", "check", "severity", "page", "role", "viewport", "title", "detail", "selector", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "check": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "serious", "moderate", "minor"] },
        "page": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "viewport": { "type": ["integer", "null"] },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "selector": { "type": "string" },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "skipped": {
      "type": "object",
      "required": ["kind", "name", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["role", "check"] },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "check": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
