{
  "name": "usability-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared usability testing: preflight checks, simulated participants, findings store and the admin panel",
  "main": "src/index.js",
  "bin": {
    "usability-kit": "bin/usability-kit.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
