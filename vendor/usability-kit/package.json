    "ci": "bash scripts/ci-local.sh"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@browserbasehq/stagehand": "^3.7.1",
    "html-validate": "^10.0.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.63.0"
  },
