{
  "manifest_version": 3,
  "name": "HSI Humanizador",
  "version": "0.7.4",
  "description": "Pasa turnos y pacientes de Human Rounds a HSI cuando no hay acceso a la API.",
  "permissions": ["storage", "scripting", "clipboardWrite"],
  "host_permissions": [
    "http://localhost:8280/*",
    "http://127.0.0.1:8280/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HSI Humanizador — cargas recientes",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pinamar.humanrounds.org/admin/*",
        "https://demo.humanrounds.org/admin/*",
        "http://localhost:7700/admin/*",
        "http://127.0.0.1:7700/admin/*"
      ],
      "js": ["lib/shared.js", "content-turnos.js"],
      "css": ["content-turnos.css"],
      "run_at": "document_idle"
    }
  ]
}
