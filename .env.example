# .env.example — Sana Turnos
#
# This is a public, non-secret configuration reference. Do not create a
# checkout `.env` for credentials. Managed local profiles load their values
# from the fixed external provider through scripts/turnos_managed_exec.py;
# production/Coolify continues to use direct runtime environment injection.
# Commented variables document configuration names and defaults only
# (server.py/system_status.py degrade gracefully when they're missing — see
# CLAUDE.md "Nothing breaks because of email or HSI").
#
# NEVER commit a filled-in .env — this file only documents the var NAMES.

# ============================================================ Core ==========

# Never put DATABASE_URL or TEST_DATABASE_URL in a checkout `.env`. Local
# DB-backed tests use managed profiles; direct deployments inject their own
# runtime environment.
#
# Least privilege (docs/architecture/registro-de-accesos.md): DATABASE_URL can
# be a role WITHOUT schema rights (scripts/db_app_role.py creates it); then
# TURNOS_DB_MIGRATION_URL carries the schema owner's login, used only at boot
# to bring the schema to head. Same database, or the boot refuses. Unset = the
# DATABASE_URL login does both, as before. Inject it like DATABASE_URL.

# HOST=0.0.0.0
# PORT=7700

# Canonical public origin used to build absolute links (emails, chat, HSI
# handoff, canonical metadata). Set this on every public deployment. An unset
# local checkout falls back to http://127.0.0.1:7700 and never to another
# installation's domain.
# TURNOS_PUBLIC_ORIGIN=https://appointments.your-town.example

# Expected final domain — drives the "Dominio" card in /admin Sistema.
# TURNOS_DOMINIO=turnos.example.org

# Points to another data package directory (swap the whole webdata/ bundle
# for another municipality) instead of the repo's own webdata/.
# TURNOS_WEBDATA_DIR=/path/to/webdata-otromunicipio

# Base dir for local mutable data (uploaded órdenes, etc). Defaults to ./data.
# TURNOS_DATA_DIR=/app/data

# Install-owned private packs root + the pack ids that must be verified before
# either HTTP server accepts traffic. Normally written by the first-run
# installer: a scaffolded town lands under <TURNOS_DATA_DIR>/packs/<slug> on the
# persistent volume and is registered here so it survives a rebuild and the boot
# gate fails closed if the volume is missing/corrupt. Process/.env only — never
# set via /admin Settings (the DB layer is unavailable at boot-gate time).
# See docs/architecture/data-packs.md and
# docs/solutions/security/required-private-pack-readiness.md.
# TURNOS_PRIVATE_PACKS_DIR=/app/data/packs
# TURNOS_REQUIRED_PACKS=your-town

# Site theme default (humanrounds/pinamar). TURNOS_TEMA_DEFAULT is the legacy
# Spanish key; both are read and the English key wins. The neutral public
# checkout defaults to humanrounds; the Pinamar deployment sets pinamar.
# TURNOS_THEME_DEFAULT=humanrounds
# TURNOS_TEMA_DEFAULT=humanrounds

# Turn off Gravatar lookups for account avatars.
# TURNOS_GRAVATAR_OFF=1

# Ops escape hatch: env/.env win over anything saved from /admin Settings,
# without touching the DB row. Never set through .env or DB — that would be
# circular; env-only by design. See docs/architecture/settings.md.
# TURNOS_CONFIG_LOCK=1

# ============================================ First-run setup wizard ========

# A fresh install (zero operators, zero config rows) serves /setup instead
# of the site — see docs/architecture/setup-wizard.md. Nothing here is
# required; both are optional hardening for a slow/scripted first boot.

# HMAC key for the wizard's own signed state cookie (answers accumulate here
# across steps, nothing touches the DB until the final commit). Random
# per-process if unset — fine for a normal one-sitting setup; pin it if a
# restart mid-wizard would be disruptive.
# TURNOS_SETUP_SECRET=

# Skip the best-effort geo-IP lookup that pre-fills the Location step's
# country guess (ip-api.com, no key, 1.5s timeout — never blocks the page
# either way, this just skips it outright).
# TURNOS_SETUP_SKIP_GEOIP=1

# ==================================================== Location & data ======

# Which packs/<id> layers are active, general-to-specific. Discovered from
# packs/ on disk; also editable live from /admin Settings once an admin
# exists. See docs/architecture/data-packs.md.
# PACK_CHAIN=global,example-town

# Curated overrides for a handful of sitio.json identity fields (hospital
# name, city, province, network name, emergency number) without editing the
# pack file or shipping a new one. Set via /admin Settings normally; env
# works too for a scripted deploy. See site_identity.OVERRIDABLE_KEYS.
# SITE_ID_HOSPITAL=
# SITE_ID_CITY=
# SITE_ID_PROVINCE=
# SITE_ID_NETWORK=
# SITE_ID_NETWORK_LONG=
# SITE_ID_EMERGENCY_NUMBER=

# Who is responsible for the patients' data (Ley 25.326), e.g.
# "Municipalidad de Pinamar — Secretaría de Salud". Set it only on an
# installation run by that institution with real patients: it switches the
# terms and the privacy policy from the prototype text to the institutional
# one (app/patient_web/legal.py). Not a Settings field. See docs/architecture/legal.md.
# SITE_ID_DATA_CONTROLLER=

# =========================================================== Languages =====

# Comma-separated, validated against the locale files under locales/ (ten
# ship: es en pt fr it de ru uk ja zh — primary subtags only). A single
# language (the default) turns the switcher off — nothing to switch
# between. Leave LANG_DEFAULT empty to let the browser's Accept-Language
# pick a newcomer's language (what the public demo does). See
# docs/architecture/i18n.md.
# LANGUAGES=es
# LANG_DEFAULT=es

# off|nav|secret — off: no switcher, ?lang= ignored even crafted by hand.
# nav: a visible switcher (nav.js), needs >=2 LANGUAGES. secret: the ?lang=
# URL trick works but nothing in the UI advertises it.
# LANG_SWITCHER_MODE=off

# Fakes machine translation of pack CONTENT (service names, palabras search
# terms, center descriptions) the same way TURNOS_FAKE_AI fakes everything
# else — read first, falls back to TURNOS_FAKE_AI when unset. Leave this
# UNSET (or =0) on any installation with a second LANGUAGES entry: setting
# TURNOS_FAKE_AI=1 without also forcing this to 0 poisons the translation
# cache with literal "[en] Clínica médica" markers that a later real sweep
# won't overwrite (matching source hash). A demo installation sets
# TURNOS_FAKE_TRANSLATE=0 explicitly so its (fake) AI mode still shows real
# translated content. See docs/architecture/i18n.md, "TURNOS_FAKE_TRANSLATE".
# TURNOS_FAKE_TRANSLATE=0

# ======================================================== Public sandbox ===

# Turns this installation into a locked-down public demo: fictional data
# only, every external integration force-disabled regardless of what else
# is configured (HSI, WhatsApp, backups, reminders...). Never set this on a
# real deployment. See docs/demo-installation.md.
# TURNOS_DEMO_MODE=1
# TURNOS_DEMO_ADMIN_USER=demo

# =================================================== Admin auth =============

# The "dueño" (owner) fallback login — legacy, predates the DB-backed
# operators table. Optional: a fresh install creates its real admin account
# through the /setup wizard (or later via admin_users.py), not through
# these. Only set these if you want the env-based owner login available too.
# TURNOS_ADMIN_USER=admin
# TURNOS_ADMIN_PASS=change-me

# Optional TOTP 2FA secret (base32) for the admin account.
# TURNOS_ADMIN_TOTP_SECRET=

# HMAC secret for admin session cookies. Auto-derived if unset (dev only) —
# set explicitly in prod so sessions survive a restart.
# TURNOS_ADMIN_SECRET=

# Clinical access log (app/core/access_log.py): who opened which patient's chart
# and medical data. The patient is stored as an HMAC of the DNI keyed with
# TURNOS_ACCESS_LOG_KEY (falls back to TURNOS_ADMIN_SECRET). Set it once and
# keep it: a new key makes older rows unreachable by DNI. Rows are kept
# TURNOS_HOUSEKEEPING_ACCESS_LOG_DAYS days (default 3650, never under 365).
# TURNOS_ACCESS_LOG_KEY=
# TURNOS_HOUSEKEEPING_ACCESS_LOG_DAYS=3650

# «Descargar» on the panel's small tables (app/admin_panel/table_export.py): the
# most rows one file may hold; a bigger table is refused with a message asking
# for a narrower day, doctor or filter. Large lists have no button at all.
# TURNOS_EXPORT_MAX_ROWS=1000

# Chat retention (problems.md №12). OFF unless set: the institution decides how
# long the chat is kept. With a period (days, minimum 30; 0 or unset = off) the
# housekeeping sweep deletes the messages of every chat channel — web with and
# without login, WhatsApp — older than it, then the session summaries and
# compactions (their own period, default the same). The pre-consultation
# interview transcript is clinical record and is never touched. Preview first:
# python3 scripts/fixes/report_chat_retention.py
# TURNOS_CHAT_RETENTION_DAYS=
# TURNOS_CHAT_SUMMARY_RETENTION_DAYS=

# TURNOS_ADMIN_SESSION_DAYS=7

# Rate limit for failed panel-login attempts per IP per day.
# TURNOS_LOGIN_PANEL_PER_DAY=20

# Password gate for the whole site while it's a private prototype (Coolify
# preview/demo deploys) — separate from the admin panel login.
# TURNOS_BASIC_AUTH_USER=demo
# TURNOS_BASIC_AUTH_PASS=

# password|renaper — which login method(s) the patient site offers.
# TURNOS_AUTH_METHODS=password
# TURNOS_AUTH_MODE=password

# ==================================================== AI inference ==========

# cloud_shared (default) keeps the existing OpenRouter transport unchanged.
# hosted_jurisdiction requires a dedicated key and HTTPS endpoint.
# self_hosted_vllm requires a dedicated key; its HTTP endpoint must be
# localhost, a literal loopback address, or a literal RFC1918 IPv4 address.
# The endpoint is the complete OpenAI-compatible chat-completions path: no
# userinfo, query parameters, or fragments. Redirects are refused.
# AI_INFERENCE_PROFILE=cloud_shared
# AI_INFERENCE_BASE_URL=https://inference.example/v1/chat/completions
# AI_INFERENCE_API_KEY=
# AI_INFERENCE_API_KEY_BACKUP=

# Legacy cloud_shared credentials remain the fallback only while the new
# dedicated fields are blank. Non-cloud profiles never use these keys.
# OPENROUTER_API_KEY=sk-or-v1-...

# Second key, used only as failover: ai_client.py retries once on the
# primary's own 402/403 (quota/auth), then stays on the backup for 5min
# once it proves live. See docs/architecture/settings.md "Backup-key
# failover".
# OPENROUTER_API_KEY_BACKUP=

# Optional management key — only used to show account balance/runway in the
# Sistema page. Never required for the app to function.
# OPENROUTER_MANAGEMENT_KEY=

# TURNOS_AI_MODEL=google/gemini-3-flash-preview
# Optional patient interview override only; unset preserves the shared baseline.
# INTAKE_INTERVIEW_MODEL=google/gemini-4-argon
# INTAKE_INTERVIEW_MAX_TOKENS=2048
# INTAKE_INTERVIEW_REASONING_EFFORT=low
# Evaluate synthetic multi-turn safety/latency before enabling an override.
# TURNOS_AI_MODEL_FALLBACK=google/gemini-2.5-flash

# Set to 1 in tests/dev to stub every AI call — see CLAUDE.md test command.
# TURNOS_FAKE_AI=1

# AI rate limits (legacy Spanish aliases still read as fallback: TURNOS_IA_ABUSO_MIN
# / TURNOS_IA_ABUSO_FALLOS — set only the English names on a fresh install).
# TURNOS_AI_PER_HOUR=
# TURNOS_AI_PER_DAY=
# TURNOS_AI_ABUSE_MIN=
# TURNOS_AI_ABUSE_FAILS=

# ia_salud.py (AI health probe / circuit breaker). Legacy aliases still read:
# TURNOS_IA_FORZAR, TURNOS_IA_PROBE_MIN, TURNOS_IA_SALUD_OFF.
# TURNOS_AI_FORCE=
# TURNOS_AI_PROBE_MIN=
# TURNOS_AI_HEALTH_OFF=

# enfriamiento_ia.py (per-IP cooldown on repeated order-photo uploads).
# TURNOS_IMG_BURST=2
# TURNOS_IMG_BASE_SECONDS=60
# TURNOS_IMG_CAP_MIN=64

# Booking-chat engine tuning.
# TURNOS_CHAT_MAX_TOKENS=450
# TURNOS_CHAT_MAX_TURNS=12
# TURNOS_CHAT_PER_HOUR=20

# Bearer token to auth GET /api/chat-transcripts (prompt-learning export).
# Route is disabled with no token set.
# TURNOS_CHAT_EXPORT_TOKEN=

# OCR rate limit (DNI-photo signup).
# TURNOS_OCR_PER_HOUR=

# ============================================================== Email =======

# Provider: empty = Mailgun (default) · mailjet · off. Without the selected
# provider's keys email is a silent skip; bookings never depend on it.
# CONNECTOR_EMAIL_TRANSPORT=
# MAIL_FROM=Human Rounds <no-reply@mg.turnos.example.org>
# MAIL_REPLY_TO=

# Mailgun. MAILGUN_API_BASE: empty = US; EU domain = https://api.eu.mailgun.net
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.turnos.example.org
# MAILGUN_API_BASE=

# Mailjet (CONNECTOR_EMAIL_TRANSPORT=mailjet): API key + secret key of the
# account or sub-account; MAIL_FROM's address or domain must be a validated
# sender there.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=

# ========================================================== Turnstile =======

# Cloudflare Turnstile (captcha) on sensitive forms (login, signup).
# TURNOS_TURNSTILE_SECRET=
# TURNOS_TURNSTILE_SITEKEY=
# TURNOS_TURNSTILE_OFF=1

# Lets an automated check (smoke test, CI, a scripted browser) skip the real
# Turnstile challenge by sending header `X-Turnstile-Test-Bypass: <this value>`.
# As sensitive as an admin password — never commit a real value, only set on
# the deploy target that runs the checks. Leave unset to disable entirely.
# TURNOS_TURNSTILE_TEST_BYPASS_SECRET=

# ==================================================== WhatsApp / OTP ========

# Which OTP transport app/cuentas/accounts.py uses for signup/password-recovery
# codes. The OTP backend ships with its endpoints LIVE (hashed codes, attempt
# caps) — only registration ENFORCEMENT is gated, by OTP_GATING_ENABLED
# (default 0). 'meta' is the production transport: the code goes ONLY as the
# approved Authentication template named in META_WA_OTP_TEMPLATE (es_AR,
# «Copiar código» button; the Human Rounds WABA has `turnos_codigo`,
# approved 2026-11-16); without that variable 'meta' sends nothing.
# 'whatsapp' only reaches a loopback dev WAHA, 'sms' is a stub. Keep
# OTP_GATING_ENABLED=0 until the patient code-entry UI ships.
# OTP_PROVIDER=whatsapp
# META_WA_OTP_TEMPLATE=
# OTP_GATING_ENABLED=0

# WAHA — LOCAL DEV ONLY (transport contract 2026-08-14): the code refuses
# non-loopback URLs, so a remote WAHA instance is zero transport, never a
# degraded fallback. Loopback example below; never reuse the Icons8/Il
# Buco/personal instances.
# OTP_WAHA_URL=http://127.0.0.1:3005
# OTP_WAHA_API_KEY=
# OTP_WAHA_SESSION=default

# WhatsApp Cloud API (Meta) — the only transport allowed in production
# (still on Meta's TEST tier today: dashboard-allowlisted recipients only,
# not production-activated). Two very different shapes: chat replies are
# free text inside the 24h window the PATIENT opens by writing first —
# policy-eligible without a template, never a delivery guarantee; the
# confirmation and day-before reminder are BUSINESS-initiated, so on Meta
# they go as the approved Utility templates `turnos_confirmacion` /
# `turnos_recordatorio` (es_AR) and only with TURNOS_WA_NOTIFY below.
# Separate from the OTP transport above. A Meta rate limit (codes 4, 80007,
# 130429, 131048, 131056, HTTP 429) pauses every Meta send for Retry-After
# (60 s without it, 15 min at most); «Sistema» shows the pause and the last
# Meta error with its cause (state in <data dir>/private/meta-wa-state.json).
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_GRAPH_VERSION=v25.0

# meta|waha — explicit transport for enviar_texto() (chat replies,
# reminders, rejection remedies). meta in production; waha works ONLY
# against a loopback OTP_WAHA_URL. Unset = Meta if META_WA_TOKEN is set,
# else a logged no-op — auto-detect NEVER selects WAHA.
# TURNOS_WA_PROVIDER=

# Verify token for the webhook's GET handshake (what Meta's dashboard asks
# for when registering the callback URL), and the shared secret WAHA sends
# on its POSTs. Unset + no META_WA_APP_SECRET = the endpoint 404s.
# TURNOS_WA_WEBHOOK_SECRET=

# Meta app secret (App dashboard -> Settings -> Basic). This is what
# authenticates Meta's inbound POSTs: it signs the raw body as
# X-Hub-Signature-256, the only credential Meta ever sends. Without it the
# callback URL has to carry ?secret=<TURNOS_WA_WEBHOOK_SECRET>, which leaves
# the shared secret visible in Meta's dashboard and in proxy access logs.
# META_WA_APP_SECRET=

# Public WhatsApp number shown as a "keep chatting here" handoff link.
# TURNOS_WA_NUMERO=+542254000000

# Hospital-initiated WhatsApp notices to patients (confirmation with the
# whole appointment, day-before reminder, rejection remedy). 1 = on; unset
# = off — chat replies are not affected. TEST_RECIPIENTS (comma-separated
# phones) restricts them to those numbers; in demo mode the list is
# mandatory, env-only, and also switches the demo's reminder sweep on.
# TURNOS_WA_NOTIFY=
# TURNOS_WA_TEST_RECIPIENTS=

# TURNOS_WA_HANDOFF_PER_HOUR=8

# How long a WhatsApp phone stays authorized to book after redeeming a
# handoff code minted by a LOGGED-IN web session (never an anonymous one).
# TURNOS_WA_HANDOFF_GRANT_DAYS=30

# =================================================== RENAPER / identity =====

# Portal gateway adapter: off by default; see docs/portal-gateway-identity.md.
# Identity headers are accepted only from the configured private gateway.
# TURNOS_PORTAL_IDENTITY_MODE=off
# Enabled deployment pins private-gateway-v1 in the process environment.
# Select ONE source: service DNS name or exact private IP list (no CIDRs).
# TURNOS_PORTAL_IDENTITY_GATEWAY_HOST=gateway.railway.internal
# TURNOS_PORTAL_IDENTITY_TRUSTED_PEERS=[]
# Reviewed pilot bindings only: [{"subject":"...","cuit":"11 digits","dni":"..."}]
# TURNOS_PORTAL_IDENTITY_BINDINGS=[]
# 1 = patients come in ONLY through the portal: the account is found or created
# by the DNI of the validated CUIT and bound to X-User-Id; no password login,
# sign-up or recovery. Empty bindings then admit every validated person; a
# list limits a pilot to it. Needs TURNOS_PORTAL_IDENTITY_MODE.
# TURNOS_PATIENT_PORTAL_LOGIN=
# The portal's sign-in page (https only) for visitors without a session. «Ingresar»
# goes there through /account/portal-login with return=<TURNOS_PUBLIC_ORIGIN><page>;
# the municipal portal reads `return` only on its SSO entry, so point it there:
# https://portal.pinamar.gob.ar/sso/login (its /login or home ignore it).
# TURNOS_PORTAL_LOGIN_URL=
# The portal's sign-out address (https only). Our own «Cerrar sesión» cannot end
# a portal session (the gateway signs the next request straight back in), so
# the staff Account screen shows the button only when this is set, and it
# leaves through it. Unset = no sign-out button.
# TURNOS_PORTAL_LOGOUT_URL=
# Test portal (an installation with no municipal portal, e.g.
# pinamar.humanrounds.org): TURNOS_PORTAL_IDENTITY_MODE=test-portal-v1 puts an
# in-process gateway with the real protocol in front of the app; sign-in at
# /test-portal/login (set TURNOS_PORTAL_LOGIN_URL to it). Refused on *.gob.ar
# and with TURNOS_STAFF_PORTAL_LOGIN. People: [{"subject","cuit","email","name",
# "password": cuentas.test_portal.hash_password(...)}]; secret >= 32 chars.
# TURNOS_TEST_PORTAL_USERS=[]
# TURNOS_TEST_PORTAL_SECRET=

# Signed link from «Resultados de laboratorio» to the provider's laboratory page
# (docs/architecture/laboratorio-paciente.md, «Provider link»). SECRET is the
# key shared with the provider's nginx `secure_link_md5`; unset = no button.
# BASE is the address without the DNI. Process env / env file only, never a
# DB setting.
# TURNOS_LAB_LINK_SECRET=
# TURNOS_LAB_LINK_BASE=https://laboratorio.pinamar.gob.ar/ingresos/hc-paciente/false

# Remote purge of backup copies of files the retention deleted (B2): on unless
# =0. On a *.gob.ar TURNOS_PUBLIC_ORIGIN (the municipal installation) it is
# always off; any other value is ignored with an ERROR in the log and a warning
# in «Sistema»: keep =0 there.
# TURNOS_BACKUP_PURGE_REMOTE=0

# real|fake — identity-verification provider for account signup.
# TURNOS_RENAPER_PROVIDER=real
# TURNOS_FAKE_RENAPER=
# TURNOS_FAKE_RENAPER_DNI=

# Serve the identity SIMULATOR on a deployed installation (needs AUTH_MODE
# =renaper + PROVIDER=stub). Off by default and loopback-only without it: the
# simulator opens a session for ANY document. Only for an installation that is
# not open to the public and wants to show the national-identity login before
# the real credentials arrive. Honored only together with TURNOS_DEMO_MODE=1
# (2026-10-23): an installation with real patients never serves it.
# TURNOS_RENAPER_STUB_DEPLOYED=

# OAuth client for the RENAPER identity provider.
# TURNOS_RENAPER_CLIENT_ID=
# TURNOS_RENAPER_CLIENT_SECRET=
# TURNOS_RENAPER_AUTHORIZE_URL=
# TURNOS_RENAPER_TOKEN_URL=
# TURNOS_RENAPER_USERINFO_URL=
# TURNOS_RENAPER_REDIRECT_URL=
# TURNOS_RENAPER_SCOPE=
# TURNOS_RENAPER_LABEL=

# TURNOS_RENAPER_PER_HOUR=

# Local dev-only store of fake test identities (renaper.py stub provider).
# TURNOS_TEST_IDENTITIES_PATH=

# ======================================================= PUCO / SISA ========

# SISA credentials for PUCO coverage lookups (both spellings read; either
# works — USER/PASS is the English pair, USUARIO/CLAVE the legacy one).
# TURNOS_SISA_USER=
# TURNOS_SISA_PASS=
# TURNOS_SISA_USUARIO=
# TURNOS_SISA_CLAVE=

# TURNOS_FAKE_PUCO=
# TURNOS_PUCO_PUBLIC=1
# TURNOS_PUCO_PER_HOUR=
# Per-coverage-type permission override; suffix is the coverage kind, e.g.
# TURNOS_PUCO_GWT_PERM_OSDE=
# TURNOS_PUCO_GWT_PERM_...=

# =============================================================== HSI ========

# Institutional EMR integration is never selected implicitly. Use `hsi` only
# for the temporary in-process adapter, or `emr_bridge` for the Enterprise API.
# CONNECTOR_EMR_SYNC=hsi
# CONNECTOR_EMR_SYNC=emr_bridge

# HSI (Hospital Sin Internación) instance this deploy pushes/pulls turnos.
# HSI_URL=http://localhost:8280
# HSI_EMAIL=admin@example.com
# HSI_PASS=
# HSI_INSTITUTION_ID=1
# Read-only, on-demand external history; validate clinical access before enabling.
# TURNOS_HSI_EXTERNAL_HISTORY=0
# TURNOS_HSI_WEB_URL=

# Skip all HSI calls (local dev without an HSI instance running).
# TURNOS_SKIP_HSI=1

# Background sync daemon (pulls HSI turnos into the local DB).
# TURNOS_HSI_SYNC_OFF=1
# TURNOS_HSI_SYNC_INTERVAL_MIN=
# TURNOS_HSI_LOOKBACK_DAYS=90

# Background resync daemon (retries failed pushes to HSI).
# TURNOS_HSI_RESYNC_OFF=1
# TURNOS_HSI_RESYNC_INTERVAL_MIN=

# ======================================================= Backups / B2 =======

# Legacy plaintext B2; new installations default OFF. Prefer encrypted R2/S3 below.
# TURNOS_B2_KEY_ID=
# TURNOS_B2_APP_KEY=
# TURNOS_B2_BUCKET_ID=
# TURNOS_B2_PREFIX=data/

TURNOS_BACKUP_OFF=1
# TURNOS_BACKUP_INTERVAL_MIN=1440

# ============================================== Rate limits & tuning ========

# TURNOS_SEARCHES_PER_DAY=
# TURNOS_HOLD_PER_HOUR=
# TURNOS_NO_SHOW_LIMIT=3

# MCP tool-calling gates (app/auth/mcp_guard.py: rate budgets at the MCP door,
# durable daily AI reservation shared by every channel through chat_tools.py).
# TURNOS_MCP_PER_MINUTE=30
# TURNOS_MCP_PER_HOUR=240
# TURNOS_MCP_WORK_PER_HOUR=180
# TURNOS_MCP_GLOBAL_WORK_PER_MINUTE=240
# TURNOS_MCP_GLOBAL_WORK_PER_HOUR=3000
# TURNOS_MCP_AI_CONCURRENCY=2
# TURNOS_MCP_AI_PER_DAY=50

# ranking_pacientes.py priors/decay for the admissions ranking.
# TURNOS_RANKING_PRIOR=0
# TURNOS_RANKING_PRIOR_PESO=4
# TURNOS_RANKING_SEMIVIDA_DIAS=365
# TURNOS_RANKING_VENTANA_DIAS=1095
# TURNOS_RANKING_DUPLICADO_DIAS=30

# Reportes cost/exchange-rate assumptions.
# TURNOS_COSTO_HORA_OPERADOR=
# TURNOS_DOLAR_BLUE_REPORTE=

# Seasonal factor for capacity reporting; report section stays hidden
# ("disponible": false) until this is set.
# TURNOS_SEASON_FACTOR=

# Reminders daemon. Legacy aliases still read: TURNOS_RECORDATORIOS_OFF,
# TURNOS_RECORDATORIO_INTERVAL_MIN.
# TURNOS_REMINDERS_OFF=1
# TURNOS_REMINDER_INTERVAL_MIN=

# Waitlist daemon. Legacy aliases still read: TURNOS_LISTA_ESPERA_OFF,
# TURNOS_LISTA_ESPERA_INTERVAL_MIN.
# TURNOS_WAITLIST_OFF=1
# TURNOS_WAITLIST_INTERVAL_MIN=

# ==================================================== Legacy / optional =====

# WebTurno connector credentials (app/connectors/webturno/webturno.py) — the
# connector's loader reads only WEBTURNO_DNI/WEBTURNO_PASS (its two declared
# config_keys). server.py's WebTurno client/owner surface (the OWNER_DNI
# boot login and the SACOTURNO_REMOTE_URL vault relay) was retired
# 2026-08-16; those two keys are dead unless you roll server.py back.
# OWNER_DNI=
# WEBTURNO_DNI=
# WEBTURNO_PASS=
# SACOTURNO_REMOTE_URL=

# ============================================ Data-pack fetch scripts =======

# Only read by scripts/fetch_brila_photos.py to download the Google Places
# center photos (the app itself never calls Google — photos live on disk in
# packs/). Stored in credential vault AI: "Google Places API key — human-rounds
# scripts".
# GOOGLE_PLACES_API_KEY=

# ============================================ Published-image install ========

# docker-compose.release.yml consumes SANA_IMAGE_DIGEST_HEX to install the
# PUBLISHED ghcr.io image instead of building from source (see that file +
# RELEASES.md). Provide the 64-character hex digest payload ONLY (no sha256:
# prefix, no @ separator) — the repository and @sha256: prefix are FIXED in
# docker-compose.release.yml (see that file for the structural hardening that
# prevents ANY value from becoming a mutable tag reference). Compose requires
# the variable to be SET and nonempty (it refuses to start without it) but does
# NOT regex-validate the 64-hex shape at config time; a malformed value parses
# and then fails at runtime pull.
#
# The 64-character hex digest payload is recorded per release in RELEASES.md
# and emitted by the release workflow's "Record immutable digest" step.
# Irrelevant to the default `build: .` dev path in docker-compose.yml.
# SANA_IMAGE_DIGEST_HEX=<64-hex-digest>

# SANA_VERSION is the human-readable companion: the version tag a release is
# cut under, recorded in RELEASES.md for reference. The Compose override does
# NOT consume this — it is informational only.
# SANA_VERSION=

# Encrypted installation backups (ops/backup_full; no Coolify dependency).
# Generate RECOVERY_KEY in setup/Settings and save it outside this server.
# It is an installation-managed secret, never a DB setting.
# TURNOS_BACKUP_ENABLED=0
# TURNOS_BACKUP_S3_ENDPOINT=
# TURNOS_BACKUP_S3_BUCKET=
# TURNOS_BACKUP_S3_KEY_ID=
# TURNOS_BACKUP_S3_SECRET=
# TURNOS_BACKUP_S3_PREFIX=human-rounds/
# TURNOS_BACKUP_S3_REGION=auto
# TURNOS_BACKUP_INTERVAL_MIN=1440
# TURNOS_BACKUP_RETAIN_DAILY=7
# TURNOS_BACKUP_RETAIN_WEEKLY=4
# TURNOS_BACKUP_RETAIN_MONTHLY=6
# Rotation deletes old archives only with =1. On a *.gob.ar TURNOS_PUBLIC_ORIGIN
# (the municipal installation) the application deletes or overwrites no backup
# by any path (app/core/backup_lock.py): =1 is ignored with an ERROR in the log and
# a warning in «Sistema», and the panel refuses to save it — keep =0 there.
# TURNOS_BACKUP_RETENTION_APPLY=0
# TURNOS_BACKUP_UPLOAD_MAX_HOURS=36
# TURNOS_BACKUP_RESTORE_MAX_DAYS=10
# TURNOS_BACKUP_RESTORE_INTERVAL_DAYS=7
# TURNOS_BACKUP_SCRATCH_DATABASE_URL=
# TURNOS_BACKUP_RECOVERY_KEY=
# TURNOS_BACKUP_OLD_KEYS_SECRET=

# Anonymous real-participant study. Only enable on the isolated public demo.
TURNOS_STUDY=0
TURNOS_STUDY_RETENTION_DAYS=90
